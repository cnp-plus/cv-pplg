# Quadlet unit untuk CV PPLG (Podman system-level).
# Dipasang oleh deploy/install.sh ke /etc/containers/systemd/cv-pplg.container.
# Quadlet mengubah file ini menjadi service systemd cv-pplg.service.
[Unit]
Description=CV PPLG PHP server (Podman, port 2027)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=cv-pplg
Image=localhost/cv-pplg:latest
PublishPort=2027:8000

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
