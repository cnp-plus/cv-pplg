[Unit]
Description=CV PPLG PHP server (Podman rootless, port 2027)
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=3
TimeoutStartSec=60
ExecStartPre=-%h/bin/podman rm -f cv-pplg
ExecStart=%h/bin/podman run --rm --init --name cv-pplg -p 2027:8000 localhost/cv-pplg:latest
ExecStop=%h/bin/podman stop -t 10 cv-pplg

[Install]
WantedBy=default.target
